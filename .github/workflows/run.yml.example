name: Gmail Filer
run-name: Gmail Filer - Run #${{ github.run_number }}

# This is a reference workflow. Copy it to your private runner repo and
# populate the variables/secrets listed below.
#
# Pattern: keep this code repo public; run the workflow from a private repo
# so secrets and logs are never exposed. See README for details.

on:
  schedule:
    - cron: "40 4 * * *"   # adjust to your desired UTC time
  workflow_dispatch:

jobs:
  run:
    runs-on: ubuntu-latest
    steps:
      - name: Compute datetime
        id: dt
        run: |
          TITLE=$(TZ='${{ vars.TIMEZONE }}' date +'Gmail Filer %-d %B, %Y %I:%M %p')
          echo "title=$TITLE" >> "$GITHUB_OUTPUT"
          echo "## $TITLE" >> "$GITHUB_STEP_SUMMARY"

      - uses: actions/checkout@v4
        with:
          repository: <your-github-username>/gmail-filer  # public code repo
          ref: master

      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"
          cache: pip

      - name: Install dependencies
        run: pip install -r requirements.lock

      - name: Run
        env:
          # --- Variables (non-sensitive, set as GitHub Actions Variables) ---
          MODEL_PROVIDER: ${{ vars.MODEL_PROVIDER }}        # openrouter | azure | gemini
          MODEL: ${{ vars.MODEL }}                          # e.g. gemini-flash-latest
          LOOKBACK_HOURS: ${{ vars.LOOKBACK_HOURS }}        # e.g. 13
          NOTIFY_CHANNELS: ${{ vars.NOTIFY_CHANNELS }}      # e.g. telegram
          AZURE_OPENAI_DEPLOYMENT: ${{ vars.AZURE_OPENAI_DEPLOYMENT }}
          AZURE_OPENAI_ENDPOINT: ${{ vars.AZURE_OPENAI_ENDPOINT }}
          GMAIL_ACCOUNTS: ${{ vars.GMAIL_ACCOUNTS }}        # e.g. personal,work,side
          GMAIL_CLIENT_ID: ${{ vars.GMAIL_CLIENT_ID }}
          EXCLUDED_TOPICS: ${{ vars.EXCLUDED_TOPICS }}      # comma-separated topics to skip
          KEY_SENDERS: ${{ vars.KEY_SENDERS }}              # comma-separated domains/addresses always marked critical
          TELEGRAM_CHAT_ID: ${{ vars.TELEGRAM_CHAT_ID }}
          TIMEZONE: ${{ vars.TIMEZONE }}                    # e.g. Asia/Kolkata, America/New_York, Europe/London

          # --- Secrets (sensitive, set as GitHub Actions Secrets) ---
          GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}
          OPENROUTER_API_KEY: ${{ secrets.OPENROUTER_API_KEY }}
          AZURE_OPENAI_API_KEY: ${{ secrets.AZURE_OPENAI_API_KEY }}
          GMAIL_CLIENT_SECRET: ${{ secrets.GMAIL_CLIENT_SECRET }}
          # One refresh token per account listed in GMAIL_ACCOUNTS.
          # Format: GMAIL_<ACCOUNT_NAME_UPPERCASE>_REFRESH_TOKEN
          # Example for accounts "personal,work":
          GMAIL_PERSONAL_REFRESH_TOKEN: ${{ secrets.GMAIL_PERSONAL_REFRESH_TOKEN }}
          GMAIL_WORK_REFRESH_TOKEN: ${{ secrets.GMAIL_WORK_REFRESH_TOKEN }}
          TELEGRAM_BOT_TOKEN: ${{ secrets.TELEGRAM_BOT_TOKEN }}
        run: python main.py

      - name: Output run title
        if: always()
        run: echo "${{ steps.dt.outputs.title }}"
