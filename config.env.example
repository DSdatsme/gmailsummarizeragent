# OpenRouter (BYOK - set your Gemini key in OpenRouter dashboard)
OPENROUTER_API_KEY=sk-or-...
MODEL=google/gemma-3-27b-it:free

# Gmail OAuth2 app credentials (shared across all accounts — from credentials.json)
GMAIL_CLIENT_ID=...
GMAIL_CLIENT_SECRET=...

# Gmail accounts (comma-separated) — run: python auth_setup.py <name> for each
GMAIL_ACCOUNTS=personal,work,side,client,other
GMAIL_PERSONAL_REFRESH_TOKEN=...
GMAIL_WORK_REFRESH_TOKEN=...
GMAIL_SIDE_REFRESH_TOKEN=...
GMAIL_CLIENT_REFRESH_TOKEN=...
GMAIL_OTHER_REFRESH_TOKEN=...

# Classification config
LOOKBACK_HOURS=13
KEY_SENDERS=example.com
EXCLUDED_TOPICS=category1, category2, category3

# Channels (comma-separated, e.g. telegram,slack)
NOTIFY_CHANNELS=telegram

# Telegram
TELEGRAM_BOT_TOKEN=...
TELEGRAM_CHAT_ID=...
